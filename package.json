{
  "name": "skuid-sfdx",
  "description": "sf CLI plugin for managing Skuid metadata",
  "version": "0.6.0",
  "author": "Skuid",
  "bugs": "https://github.com/skuid/skuid-sfdx/issues",
  "dependencies": {
    "@oclif/core": "^5.0.0",
    "@salesforce/core": "^9.1.9",
    "@salesforce/kit": "^4.0.0",
    "@salesforce/sf-plugins-core": "^13.0.4",
    "@salesforce/ts-types": "^3.2.0",
    "glob": "^13.0.6",
    "json-stable-stringify": "^1.3.0",
    "tslib": "^2.8.1",
    "vkbeautify": "^0.99.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/sinon": "^17.0.3",
    "chai": "^5.1.2",
    "eslint": "^9.17.0",
    "mocha": "^11.1.0",
    "oclif": "^5.0.0",
    "rimraf": "^6.0.1",
    "sinon": "^19.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "/lib",
    "/messages",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/skuid/skuid-sfdx",
  "keywords": [
    "sfdx-plugin"
  ],
  "license": "MIT",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "sf",
    "topics": {
      "skuid:page:pull": {
        "description": "Retrieves Skuid Pages from a target org into a filesystem directory."
      },
      "skuid:page:push": {
        "description": "Push Skuid Pages from a directory to Skuid."
      }
    }
  },
  "repository": "skuid/skuid-sfdx",
  "scripts": {
    "lint-fix": "eslint src test --fix",
    "postpack": "rimraf oclif.manifest.json",
    "posttest": "eslint src test",
    "prepack": "rimraf lib && tsc -b && oclif manifest",
    "test": "mocha"
  },
  "type": "module"
}
